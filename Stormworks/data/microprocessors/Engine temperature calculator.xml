				<object id="39" script='gN=input.getNumber
gPN=property.getNumber
sN=output.setNumber

MeasInt=gPN("Measurement interval")
TimeMult=gPN("Time multiplier")
emaDepth=gPN("EMA depth")

cntr=MeasInt*60

temp,oldT,oldT1=0,0,0
tPerSec=0
limT=0
limCntr=4

function onTick()
	
	if cntr&gt;0 then cntr=cntr-1 end
	if cntr==0 then
		cntr=MeasInt*60
		t=gN(1)
		if emaDepth&gt;1 then
			temp=SetEMA(tEMA,t)
		else
			temp=t
		end
		if oldT==0 then oldT=temp end
		dT=temp-oldT
		tPerSec=dT/MeasInt
		
		if limCntr&gt;0 then limCntr=limCntr-1 end
		if limCntr==0 then
			denum=oldT1+temp-2*oldT
			if math.abs(denum)&lt;0.00000001 then
				limT=0
			else
				lT=(oldT1*temp-oldT*oldT)/denum
				if lT&gt;0 then
					if emaDepth&gt;1 then
						limT=SetEMA(limEMA,lT)
					else
						limT=lT
					end
				end
			end
		end
		oldT1=oldT
		oldT=temp
	end	
	
	sN(1,tPerSec*TimeMult)
	sN(2,limT)
end

function NewEMA(depth) return {val=0,d=depth} end
function SetEMA(ema,val) ema.val=(ema.val*(ema.d-1)+val)/ema.d return ema.val end

