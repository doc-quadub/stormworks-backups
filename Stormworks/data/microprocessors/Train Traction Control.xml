			<c type="56">
				<object id="61" script='position_count = property.getNumber("Position Count")
min_traction = property.getNumber("Minimum Traction")
max_traction = property.getNumber("Maximum Traction")
control_axis = property.getNumber("Control Axis")
incrementMode = property.getBool("Control Mode")
inc_traction = property.getNumber("Traction Increment")

current_position = 0
prev_seat_state = 0
prev_plus_state = false
prev_minus_state = false

function onTick()
	local from_seat = 0
	local from_seatPlus = false
	local from_seatMinus = false
	
	EBR = input.getBool(3)

	if control_axis == 1 then
		from_seat = input.getNumber(1)
	elseif control_axis == 2 then
		from_seat = input.getNumber(2)
	elseif control_axis == 3 then
	    from_seat = input.getNumber(3)
	elseif control_axis == 4 then
	    from_seat = input.getNumber(4)
	elseif control_axis == 5 then
		from_seatPlus = input.getBool(1)
		from_seatMinus = input.getBool(2)
	end
	
    if control_axis &gt;= 1 and control_axis &lt;= 4 then
        if from_seat &gt; 0 and prev_seat_state &lt;= 0 then
            current_position = current_position + 1
        elseif from_seat &lt; 0 and prev_seat_state &gt;= 0 then
            current_position = current_position - 1
        end
        prev_seat_state = from_seat
    end

    if control_axis == 5 then
        if from_seatPlus and not prev_plus_state then
            current_position = current_position + 1
        end
        if from_seatMinus and not prev_minus_state then
            current_position = current_position - 1
        end
        prev_plus_state = from_seatPlus
        prev_minus_state = from_seatMinus
    end

    current_position = math.max(0, math.min(current_position, position_count))
	
	if EBR == true then
		traction = 0
		prev_seat_state = 0
		prev_plus_state = false
		prev_minus_state = false
		current_position = 0
	else
    	if current_position == 0 then
        	traction = 0
    	elseif position_count &lt;= 1 then
        	traction = min_traction
    	else
            if incrementMode then
                traction = min_traction + (current_position - 1) * inc_traction
                traction = math.min(traction, max_traction)
            else
                local t = (current_position - 1) / (position_count - 1)
                traction = min_traction + t * (max_traction - min_traction)
            end
    	end
	end

    output.setNumber(1, traction)
    output.setNumber(2, current_position)
end'>
