		chargerRelay = false
		
		if batteryCharge &gt;= dischargeValue then
			dischargerPivot = 1
		else
			dischargerPivot = 0
		end
	elseif toggleDimmer == false then
		dischargerPivot = 0
		
		if batteryCharge &lt;= chargeValue then
			chargerRelay = true
		else
			chargerRelay = false
		end
	end

	output.setNumber(1, dischargerPivot)
	output.setBool(1, chargerRelay)
end'>
