	customChargeValue = property.getBool("Custom Charge Value?")
	
	if customDischargeValue then
		dischargeValue = input.getNumber(2)
	else
		dischargeValue = property.getNumber("Discharge value")
	end
	
	if customChargeValue then
		chargeValue = input.getNumber(3)
	else
		chargeValue = property.getNumber("Charge value")
	end
	
