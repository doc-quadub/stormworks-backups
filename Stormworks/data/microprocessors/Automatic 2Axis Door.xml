		if ticks &gt; 0 then 
			ticks = ticks - 1
		end
		
		slidersOpenClose = -1
		
		if ticks &lt;= 0 then
			slidersInOut = -1
		end
		hardpoint = false -- Hardpoint Release = False
	end
	
	output.setNumber(1, slidersInOut)
	output.setNumber(2, slidersOpenClose)
	output.setBool(1, hardpoint)
	
	output.setNumber(3, ticks)
	output.setBool(2, doorSwitch)
end
