                                    current_value = current_value + 1
                                else
                                    if current_value == 39 then
                                        current_value = 40
                                    else
                                        current_value = current_value + 1
                                    end
                                end
                            end
                        end
                    end
                else
                    if minusBlink then
                        if current_value &gt; 0 then
                            if current_value == 22 then
                                current_value = 21
                            else
                                if current_value == 40 then
                                    current_value = 39
                                else
                                    current_value = current_value - 1
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    
    output.setNumber(1, current_value)
