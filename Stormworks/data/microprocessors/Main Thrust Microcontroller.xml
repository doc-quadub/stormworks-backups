        if current_value &gt;= 40 then
            current_value = 39
        else
            if current_value &gt;= 22 then
                current_value = 21
            else
                current_value = 0
            end
        end
    else
        if plusOne then
            if current_value &lt; 56 then
                if current_value &lt; 21 then
                    current_value = current_value + 1
                else
                    if current_value == 21 then
                        current_value = 22
                    else
                        if current_value &lt; 39 then
                            current_value = current_value + 1
                        else
                            if current_value == 39 then
                                current_value = 40
                            else
                                current_value = current_value + 1
                            end
                        end
                    end
                end
            end
        else
            if minusOne then
                if current_value &gt; 0 then
                    if current_value == 22 then
                        current_value = 21
                    else
                        if current_value == 40 then
                            current_value = 39
                        else
                            current_value = current_value - 1
                        end
                    end
                end
            else
                if plusBlink then
                    if current_value &lt; 56 then
                        if current_value &lt; 21 then
                            current_value = current_value + 1
                        else
                            if current_value == 21 then
                                current_value = 22
                            else
