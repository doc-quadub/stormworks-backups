function onTick()
    local t, D = input.getNumber(1), input.getNumber(2)
    local a = t * 2 * math.pi
    local tx, ty = math.cos(a) * D, math.sin(a) * D
    local dx, dy = tc &gt; 0 and tx - px or 0, tc &gt; 0 and ty - py or 0
    px, py, tc = tx, ty, tc + 1
    local V, c = 0, 0
    if tc &gt; 1 then
        V = math.sqrt(dx^2 + dy^2) / (1 / 60)
        c = (0.5 - math.atan(dy, dx) / (2 * math.pi)) * (-1)
        if c &gt; 0.5 then c = c - 1 end
        if c &lt; -0.5 then c = c + 1 end
    end
    output.setNumber(1, V)
    output.setNumber(2, c)
end
