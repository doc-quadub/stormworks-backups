function onTick()
    RPS = input.getNumber(1)
    tractionPos = input.getNumber(2)
    regenerativeBrakeRate = input.getNumber(3)
	movementIsAllowed = input.getBool(1)
	motorCount = property.getNumber("Number of Motors")
    gearRatio = property.getNumber("Gear Ratio")
	
	if movementIsAllowed and tractionPos &gt; 0 then
		consumptionRate = (patternCons * RPS * gearRatio * motorCount) - regenerativeBrakeRate
		totalConsumption = totalConsumption + consumptionRate / 60
	end

    sWattPerSecond = consumptionRate
    kilosWattPerHour = totalConsumption / 3600000

    output.setNumber(1, totalConsumption)
    output.setNumber(2, sWattPerSecond)
    output.setNumber(3, kilosWattPerHour)
end'>
