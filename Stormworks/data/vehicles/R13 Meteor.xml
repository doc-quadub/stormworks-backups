><node label="Physics Sensor Data" mode="1" type="5"/></n><n id="7" component_id="39"><node label="Hardpoint Data" mode="1" type="5" description="1-2ch - Target X-Y"><position x="1"/></node></n><n id="8" component_id="43"><node label="Fin" type="5" description="Pitch and Yaw"><position x="3"/></node></n><n id="9" component_id="46"><node label="Roll" type="1"><position x="1"/></node></n><n id="10" component_id="48"><node label="Radar Data" mode="1" type="5"><position x="2"/></node></n><n id="11" component_id="49"><node label="Start?" mode="1"/></n><n id="12" component_id="51"><node label="Radar Toggle"><position x="2"/></node></n><n id="13" component_id="53"><node label="After Start"><position x="3"/></node></n><n id="14" component_id="134"><node label="Laser Distance Sensor Data" mode="1" type="1"><position x="4"/></node></n><n id="15" component_id="137"><node label="To Laser Distance Sensor" type="5"><position x="4"/></node></n><n id="16" component_id="174"><node label="Missile Radar Data" mode="1" type="5"><position x="5"/></node></n></nodes><group><data><inputs/><outputs/></data><components><c type="56"><object id="54" script='s,scr,i,o,m,p = self,screen,input,output,math,property
sc,dl,dt,dtb,dr,dc = scr.setColor,scr.drawLine,scr.drawText,scr.drawTextBox,scr.drawRect,scr.drawCircle
gn,gb,sn,sb,sf,pgn,pgb = i.getNumber,i.getBool,o.setNumber,o.setBool,string.format,p.getNumber, p.getBool
pi,pi2,abs,sqrt,atan,random,floor,max,min,sin,cos = m.pi,m.pi*2,m.abs,m.sqrt,m.atan,m.random,m.floor,m.max,m.min,m.sin,m.cos

function PID(kp,ki,kd,oMin,oMax,intLimit)
    return {
        kp=kp,
        ki=ki,
        kd=kd,
        intrl=0,
        pErr=0,
        oMin=oMin or -1,
        oMax=oMax or 1,
        intLimit=intLimit or 10,
        update=function(self,sp,pv,enable)
            if not enable then
                self.intrl=0
                self.pErr=0
                return 0
            end
            local error=sp-pv
            self.intrl=self.intrl+error
            if self.intrl&gt;self.intLimit then
                self.intrl=self.intLimit
            elseif self.intrl&lt;-self.intLimit then
                self.intrl=-self.intLimit
            end
            local der=error-self.pErr
            self.pErr=error
            local output =
                self.kp*error+
                self.ki*self.intrl+
                self.kd*der
            if output&gt;self.oMax then
                output=self.oMax
            elseif output&lt;self.oMin then
                output=self.oMin
            end
            return output
        end
    }
end
toPitchPID=PID(2,0.1,2,-1,1,1)
toPitchAnglePID=PID(0.005,0,1,-0.2,0.2,1)
toRollPID=PID(1,0,10,-1,1,1)
mX,mAlt,mY,mPitch=0,0,0,0
mRoll,mCompass,tX,tY=0,0,0,0
trgtAlt,t1,abj,laserDist=0,0,0,0
azToTarget,elToTarget,distToTarget,t2=0,0,0,0
t3=0
terrFollow=false
maxFlyDist=pgn("Maximum Fly Distance (m)")
if not maxFlyDist or maxFlyDist&lt;=0 then
    maxFlyDist=30000
end
flyDistance=maxFlyDist+random(1,floor(maxFlyDist*0.1))
function onTick()
	mX=gn(1)
	mAlt=gn(2)
	mY=gn(3)
	mPitch=gn(4)
	mRoll=gn(5)
	mCompass=gn(6)
	tX=gn(7)
	tY=gn(8)
	laserDist=gn(9)
	mSpeed=gn(10)
	azToTarget=gn(11)
	elToTarget=gn(12)
	distToTarget=gn(13)
	manualSetAltitude=gn(14)
	attackMode=gn(15)
	start=gb(1)
	targetFound=gb(2)
	if not start then
		tXMem=tX
		tYMem=tY
		mXMem=mX
		mYMem=mY
		manualSetAltitudeMem=manualSetAltitude
		attackModeMem=attackMode
	end
	if manualSetAltitudeMem~=0 and manualSetAltitudeMem&gt;20 then
		setAltitude=manualSetAltitudeMem
	else
		setAltitude=pgn("Hold Altitude")
	end
	startDistToPoint=sqrt(((tXMem-mXMem)^2)+((tYMem-mYMem)^2))
	actualDistToPoint=sqrt(((tXMem-mX)^2)+((tYMem-mY)^2))
	dirToPoint=5*(((atan(tXMem-mX,tYMem-mY)/pi2+mCompass)%1+1.5)%1-0.5)
	if start then
		t1=t1+1
		traveledDist=floor((t1*215)/60)
		if t1&gt;=135 then
			afterStart = true
			toYaw=max(-0.35,min(0.35,dirToPoint))
		else
			afterStart = false
		end
		if t1&gt;=300 then
			if laserDist&lt;500 then
				terrFollow=true
			end
			if terrFollow then
				abj=abj+3
				t3=t3+1
			end
			if laserDist&gt;500 and abj&gt;0 and t3&gt;=60 then
				terrFollow=false
				t2=t2+1
				if t2&gt;=120 then
					abj=abj-0.5
				end
			elseif abj&lt;=0 then
				t2=0
				t3=0
			end
		end
		if attackMode == 0 then
			if t1&gt;=300 then
				if traveledDist&gt;=flyDistance then
					pitchCascade=0
					toPitch=0
				else
					if actualDistToPoint&lt;2500 and actualDistToPoint&gt;1500 and mAlt&lt;400 then
						toPitch=toPitchPID:update(0.2,mPitch,start)
					elseif actualDistToPoint&lt;1500 then
						toPitch=toPitchPID:update(-0.2,mPitch,start)
					else
						altHold=setAltitude
						pitchCascade=-toPitchAnglePID:update(altHold+abj,mAlt,start)
						toPitch=-toPitchPID:update(pitchCascade,mPitch,start)
					end
				end
			else
				altHold=setAltitude*2.5
				pitchCascade=-toPitchAnglePID:update(altHold,mAlt,start)
				toPitch=-toPitchPID:update(pitchCascade,mPitch,start)
			end
			if targetFound and distToTarget&lt;2000 then
				toYaw=azToTarget*0.35
				toPitch=elToTarget*0.35
			end
		elseif attackMode == 1 or startDistToPoint&lt;6000 then
			if traveledDist&gt;=flyDistance then
				pitchCascade=0
				toPitch=0
			else
				altHold=setAltitude
				pitchCascade=-toPitchAnglePID:update(altHold+abj,mAlt,start)
				toPitch=-toPitchPID:update(pitchCascade,mPitch,start)
			end
			if targetFound and distToTarget&lt;2000 then
				toYaw=azToTarget*0.35
				if targetFound and distToTarget&lt;500 then
					toPitch=elToTarget*0.35
				end
			end
		end
		if actualDistToPoint&lt;2000 then
			radarToggle=true
		else
			radarToggle=false
		end
		toRoll=toRollPID:update(0,mRoll,start)
	end
	sn(1,toYaw)
	sn(2,toPitch)
	sn(3,toRoll)
